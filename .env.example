# Supabase
# NEXT_PUBLIC_* names are canonical (required by Next.js browser inlining);
# the API/worker read the same vars. URL + anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://localhost:6379
# Enriched leaderboard read cache (seconds). Sorted sets themselves have no TTL.
LEADERBOARD_CACHE_TTL_SECONDS=15

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gemini
GEMINI_API_KEY=

# Sentry — one canonical DSN (NEXT_PUBLIC_ prefix required for the browser
# bundle; API/worker read the same var). DSNs are public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload during production builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# API
PORT=3001
NODE_ENV=development

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pullquest123
