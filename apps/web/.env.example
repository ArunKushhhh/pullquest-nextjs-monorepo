# Web app env — loaded by Next.js (Next reads THIS file, not the repo root .env).
# NEVER put server secrets here (service role key, Stripe/GitHub private keys):
# this app's bundle ships to browsers.

# Supabase (public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001

# GitHub App (public install link)
NEXT_PUBLIC_GITHUB_APP_NAME=pullquest-nextjs

# Sentry (DSNs are public by design)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload during production builds (build-time only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
